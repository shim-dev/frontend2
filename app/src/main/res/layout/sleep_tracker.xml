<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    android:background="@drawable/rounded_black_background">

    <LinearLayout
        android:id="@+id/timeInputContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnCompleteSleep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 시간 입력 -->
        <EditText
            android:id="@+id/editHour"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/chat_bubble"
            android:gravity="center"
            android:inputType="number"
            android:textSize="72sp"
            android:textColor="#000000"
            android:hint="00"
            android:maxLength="2"
            android:padding="0dp"
            android:layout_marginEnd="8dp"/>


        <!-- 구분선 -->
        <TextView
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text=":"
            android:textColor="#FFFFFF"
            android:textSize="80sp" />

        <!-- 분 입력 -->
        <EditText
            android:id="@+id/editMinute"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/chat_bubble"
            android:gravity="center"
            android:inputType="number"
            android:textSize="72sp"
            android:textColor="#000000"
            android:hint="00"
            android:maxLength="2"
            android:padding="0dp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnCompleteSleep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="완료"
        android:textColor="@android:color/black"  app:backgroundTint="@android:color/white"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/timeInputContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>