<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 기존 버튼 스타일 -->
    <style name="OptionButton">
        <item name="android:background">@drawable/outline_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- res/values/styles.xml -->
    <style name="BotIconStyle">
        <item name="android:layout_width">@dimen/bot_icon_size</item>
        <item name="android:layout_height">@dimen/bot_icon_size</item>
        <item name="android:src">@drawable/bot_image</item>
        <item name="android:scaleType">centerCrop</item>   <!-- 또는 centerInside -->
        <item name="android:adjustViewBounds">false</item>
        <item name="android:layout_marginStart">@dimen/bot_icon_margin</item>
    </style>

    <style name="UserIconStyle">
        <item name="android:layout_width">@dimen/bot_icon_size</item>
        <item name="android:layout_height">@dimen/bot_icon_size</item>
        <item name="android:src">@drawable/user_image</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:adjustViewBounds">false</item>
        <item name="android:layout_marginStart">@dimen/bot_icon_margin</item>
        <item name="android:layout_gravity">center_vertical</item> <!-- 추가 -->
    </style>

</resources>
