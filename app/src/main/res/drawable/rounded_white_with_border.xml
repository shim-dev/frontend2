<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 배경색 -->
    <solid android:color="#FFFFFF" />

    <!-- 테두리(윤곽선) -->
    <stroke
        android:width="2dp"
        android:color="#CCCCCC" />

    <!-- 모서리 둥글게 -->
    <corners android:radius="12dp" />

    <!-- 버튼 내부 여백 -->
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="8dp" />
</shape>
