<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAF8">

    <!-- 메인 콘텐츠 -->
    <ScrollView
        android:id="@+id/rootLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/include_bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 인사말 + 프로필 이미지 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/greetingText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="건강한 하루 시작해볼까요?\n혜진님"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000" />

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_my"
                    android:contentDescription="프로필"
                    android:background="@drawable/rounded_gray"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp" />
            </LinearLayout>


            <TextView
                android:id="@+id/startChatBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="채팅 시작하기"
                android:textSize="16sp"
                android:background="@drawable/rounded_white_with_border"
                android:textColor="#000000"
                android:elevation="4dp"
                android:layout_marginBottom="24dp"
                android:clickable="true"
                android:focusable="true" />




            <!-- 채팅 기록 + 화살표 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="채팅 기록"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chatArrowText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=">"
                    android:textSize="24sp"
                    android:textColor="#000000" />
            </LinearLayout>


            <!-- 채팅 기록 리스트 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chatDate1"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="7 / 16"
                        android:textColor="#000000"
                        android:background="@drawable/rounded_button"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chatDate2"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="7 / 16"
                        android:layout_marginStart="8dp"
                        android:textColor="#000000"
                        android:background="@drawable/rounded_button"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chatDate3"
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="7 / 16"
                        android:layout_marginStart="8dp"
                        android:textColor="#000000"
                        android:background="@drawable/rounded_button"
                        android:elevation="2dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최종 점수"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.example.it_contest.ScoreCircleView
                    android:id="@+id/scoreCircleView"
                    android:layout_width="250dp"
                    android:layout_height="300dp"
                    android:layout_marginBottom="20dp" />
            </LinearLayout>


            <!-- 식사 기록 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="식사 기록"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2"
                android:alignmentMode="alignMargins"
                android:layout_marginBottom="20dp"
                android:columnOrderPreserved="false">

                <!-- 아침 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/morningBtn"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌅"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="아침"
                                android:textSize="16sp"
                                android:textColor="#000000" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/morningScore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="85"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="@drawable/circle_black"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- 점심 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/lunchBtn"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="☀️"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="점심"
                                android:textSize="16sp"
                                android:textColor="#000000" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lunchScore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="55"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="@drawable/circle_black"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- 저녁 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/dinnerBtn"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌙"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="저녁"
                                android:textSize="16sp"
                                android:textColor="#000000" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/dinnerScore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="63"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="@drawable/circle_black"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- 간식 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/snackBtn"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#DDDDDD"
                    app:strokeWidth="2dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍪"
                                android:textSize="24sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="간식"
                                android:textSize="16sp"
                                android:textColor="#000000" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/snackScore"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:text="30"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:background="@drawable/circle_black"
                            android:layout_alignParentBottom="true"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>


            </GridLayout>



        </LinearLayout>
    </ScrollView>

    <!-- 하단 네비게이션 바 -->
    <include
        android:id="@+id/include_bottom_nav"
        layout="@layout/bottom_navigation_main"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
